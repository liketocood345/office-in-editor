+++ b/packages/adapters/vsix/src/harness-chat.ts
@@ -0,0 +1,126 @@
+import * as vscode from "vscode";
+
+/**
+ * Add to Chat delivery into DeepSeek Harness chat extensions.
+ *
+ * Neither extension exposes an API for other extensions, so delivery uses only
+ * what each one already does for its own users:
+ * - skymecode.deepseek-harness-for-vscode attaches the active text editor's
+ *   selection to its composer (setting deepseekHarness.autoAttachSelection,
+ *   default on). The reference is shown in a read-only editor and selected.
+ * - lucasliang.harness-connector-deepseek (pwhMass/deepseek-harness-vscode)
+ *   inserts an @ mention through its public command deepseekHarness.addFileToChat.
+ *   The reference is written to a file the Harness host can read.
+ */
+
+export type HarnessKind = "skymecode" | "connector";
+
+const SKYMECODE_ID = "skymecode.deepseek-harness-for-vscode";
+const CONNECTOR_ID = "lucasliang.harness-connector-deepseek";
+const SKYMECODE_VIEW = "deepseekHarness.chatView";
+const CONNECTOR_VIEW = "deepseekHarness.sessionView";
+const REFERENCE_SCHEME = "office-in-editor-ref";
+const KEEP_REFERENCES = 12;
+
+export function harnessTarget(): HarnessKind | undefined {
+  const setting = vscode.workspace.getConfiguration("officeInEditor").get<string>("chatTarget", "auto");
+  if (setting === "builtin") return undefined;
+  if (vscode.extensions.getExtension(SKYMECODE_ID)) return "skymecode";
+  if (vscode.extensions.getExtension(CONNECTOR_ID)) return "connector";
+  return undefined;
+}
+
+function safeName(value: string): string {
+  const name = value.replace(/[\u0000-\u001f\u007f"*/:<>?\\|]/gu, "_").replace(/\s+/gu, " ").trim().slice(0, 80);
+  return name === "" ? "Office" : name;
+}
+
+export class HarnessChat implements vscode.Disposable {
+  private readonly contents = new Map<string, string>();
+  private readonly registration: vscode.Disposable;
+  private counter = 0;
+  private connectorViewShown = false;
+
+  constructor(private readonly storage: vscode.Uri, private readonly trace: (stage: string) => void) {
+    this.registration = vscode.workspace.registerTextDocumentContentProvider(REFERENCE_SCHEME, {
+      provideTextDocumentContent: uri => this.contents.get(uri.toString()) ?? "",
+    });
+  }
+
+  async place(kind: HarnessKind, documentName: string, text: string): Promise<boolean> {
+    try {
+      const placed = kind === "skymecode"
+        ? await this.placeSkymecode(documentName, text)
+        : await this.placeConnector(documentName, text);
+      this.trace(kind + (placed ? "_placed" : "_not_placed"));
+      return placed;
+    } catch {
+      this.trace(kind + "_failed");
+      return false;
+    }
+  }
+
+  private async placeSkymecode(documentName: string, text: string): Promise<boolean> {
+    const uri = vscode.Uri.from({
+      scheme: REFERENCE_SCHEME,
+      path: "/" + safeName(documentName) + " 选区.md",
+      query: String(++this.counter),
+    });
+    this.contents.set(uri.toString(), text);
+    while (this.contents.size > KEEP_REFERENCES) {
+      const oldest = this.contents.keys().next().value;
+      if (oldest === undefined) break;
+      this.contents.delete(oldest);
+    }
+    const document = await vscode.workspace.openTextDocument(uri);
+    const editor = await vscode.window.showTextDocument(document, { preview: true, preserveFocus: false });
+    const end = document.lineAt(document.lineCount - 1).range.end;
+    editor.selection = new vscode.Selection(new vscode.Position(0, 0), end);
+    editor.revealRange(new vscode.Range(0, 0, 0, 0));
+    this.trace("skymecode_selection_set");
+    // The chat keeps its page alive once shown; on first show it reads the
+    // current selection when its page reports ready.
+    await vscode.commands.executeCommand(SKYMECODE_VIEW + ".focus");
+    this.trace("skymecode_view_focused");
+    return true;
+  }
+
+  private async placeConnector(documentName: string, text: string): Promise<boolean> {
+    const folder = vscode.Uri.joinPath(this.storage, "chat-refs");
+    await vscode.workspace.fs.createDirectory(folder);
+    const stamp = Date.now().toString(36) + (++this.counter).toString(36);
+    const file = vscode.Uri.joinPath(folder, safeName(documentName).replace(/\s/gu, "_") + "-" + stamp + ".md");
+    await vscode.workspace.fs.writeFile(file, new TextEncoder().encode(text));
+    await this.pruneConnector(folder);
+    await vscode.commands.executeCommand(CONNECTOR_VIEW + ".focus");
+    this.trace("connector_view_focused");
+    // Its page drops messages posted before it loads; after the first show it
+    // is retained while hidden.
+    if (!this.connectorViewShown) await new Promise(resolve => setTimeout(resolve, 1_500));
+    this.connectorViewShown = true;
+    await vscode.commands.executeCommand("deepseekHarness.addFileToChat", file);
+    return true;
+  }
+
+  private async pruneConnector(folder: vscode.Uri): Promise<void> {
+    try {
+      const files = (await vscode.workspace.fs.readDirectory(folder))
+        .filter(([name, type]) => type === vscode.FileType.File && name.endsWith(".md"))
+        .map(([name]) => name);
+      if (files.length <= KEEP_REFERENCES) return;
+      const stamps = await Promise.all(files.map(async name => {
+        const uri = vscode.Uri.joinPath(folder, name);
+        return { uri, mtime: (await vscode.workspace.fs.stat(uri)).mtime };
+      }));
+      stamps.sort((a, b) => b.mtime - a.mtime);
+      for (const stale of stamps.slice(KEEP_REFERENCES)) {
+        try { await vscode.workspace.fs.delete(stale.uri); } catch { /* still referenced by an open chat */ }
+      }
+    } catch { /* pruning is best effort */ }
+  }
+
+  dispose(): void {
+    this.registration.dispose();
+    this.contents.clear();
+  }
+}
